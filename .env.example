# ==========================================
# Configuración del Backend - Telemetría
# ==========================================

# FIWARE Orion Context Broker
ORION_PORT=1026

# MongoDB (Uso interno de Orion, no expuesto al exterior)
MONGO_PORT=27017

# InfluxDB (Time-Series Database)
INFLUXDB_PORT=8086
INFLUXDB_DB=telemetry_cb300f
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=super_secret_password_here
